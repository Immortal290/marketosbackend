NODE_ENV=development
PORT=3001

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/marketos?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Kafka
KAFKA_BROKER=localhost:9092
KAFKA_CLIENT_ID=marketos-backend

# Auth
JWT_SECRET=super_secret_jwt_key_for_development_only
JWT_EXPIRES_IN=1d
REFRESH_TOKEN_SECRET=super_secret_refresh_key_for_development_only
REFRESH_TOKEN_EXPIRES_IN=7d

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=https://digitalmarketingagent-production.up.railway.app,http://localhost:5500,http://127.0.0.1:5500,http://localhost:3001

# Agent Service (Python — renewed-dedication on Railway)
# Production (Railway private networking — zero-egress, low latency):
#   AGENT_SERVICE_URL=http://renewed-dedication.railway.internal:8000
# Local development:
AGENT_SERVICE_URL=http://localhost:8000

# ─── WhatsApp Campaign Feature ────────────────────────────────────────────────
# AI that writes the WhatsApp message from the campaign prompt.
# Free tier, no credit card — get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# WhatsApp sending via Zernio (zernio.com)
# Get these from your Zernio dashboard after connecting your WhatsApp Business number.
ZERNIO_API_KEY=sk_502588cb4b4e3f0c4315065966a8f8a898c145e5777fb4990219a82bc3db5b74
# ZERNIO_ACCOUNT_ID: set this to the _id of your connected WhatsApp Business account.
# Until you connect a real number, use the sandbox accountId for testing:
# Sandbox number: +12029087457  |  Sandbox accountId: 6a180a034c7f364ffded3c9c
ZERNIO_ACCOUNT_ID=6a180a034c7f364ffded3c9c

# Optional: country code prefix added to 10-digit numbers without a country code (e.g. 91 for India)
DEFAULT_COUNTRY_CODE=

# Safety cap: max recipients per single send request
MAX_RECIPIENTS=500
