# ─── MarketOS Docker Compose Environment ─────────────────────────────────────
# Copy this to .env and update values for your environment.
# DO NOT commit real secrets to version control.

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=marketos

# JWT Auth
JWT_SECRET=super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=super_secret_refresh_key_change_in_production
JWT_REFRESH_EXPIRES_IN=7d

# CORS — Frontend origins allowed to hit the API
# Locally: frontend container is on port 8080
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# ─── LLM Provider ─────────────────────────────────────────────────────────────
# Options: gemini | anthropic | openrouter | glm
LLM_PROVIDER=gemini

# GLM-5.2 via NVIDIA Integrate API (orchestration head)
# Get your key at: https://integrate.api.nvidia.com
NVIDIA_API_KEY=your_nvidia_api_key_here

# Other LLM keys (set whichever matches LLM_PROVIDER)
# GEMINI_API_KEY=your_gemini_key_here
# ANTHROPIC_API_KEY=your_anthropic_key_here
# OPENROUTER_API_KEY=your_openrouter_key_here

# ─── Agent Service (Python — marketos-agents on Railway) ─────────────────────
# The Python FastAPI agent service that runs the 18-agent LangGraph pipeline.
#
# Railway private networking (recommended for production):
#   - Uses the internal DNS name format: <service-name>.railway.internal
#   - Traffic stays within Railway's private network (no egress, low latency)
#   - Port is the app's actual bind port (NOT the public Railway port)
#   - Enable Private Networking in the agent service Settings → Networking
#
# Option A — Hardcoded (replace service name + port as needed):
AGENT_SERVICE_URL=http://renewed-dedication.railway.internal:8000
#
# Option B — Railway variable reference (auto-updates if service is renamed):
# AGENT_SERVICE_URL=http://${{renewed-dedication.RAILWAY_PRIVATE_DOMAIN}}:8000
#
# Local development (Python uvicorn server):
# AGENT_SERVICE_URL=http://localhost:8000
